{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/rinse/schemas/reflection_record.schema.json",
  "title": "RINSE Reflection Record v0.2",
  "description": "A deterministic, versioned and reversible interpretation record derived from immutable source traces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "digest",
    "subject_id",
    "statement",
    "status",
    "source_trace_ids",
    "evidence_relations",
    "interpretation_relations",
    "missing_evidence",
    "valid_time",
    "recorded_time",
    "reviewed_time",
    "confidence",
    "proposed_transition",
    "authority"
  ],
  "properties": {
    "schema": { "const": "rinse.reflection-record.v0.2" },
    "id": { "type": "string", "pattern": "^rinse-reflection-[0-9a-f]{16}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "subject_id": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "PROPOSED",
        "SUPPORTED",
        "SUPPORTED_WITH_LIMITS",
        "CONTESTED",
        "INSUFFICIENT_EVIDENCE",
        "RETIRED"
      ]
    },
    "source_trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": { "enum": ["SUPPORTED_BY", "CONTRADICTED_BY"] },
          "ref": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interpretation_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target_id"],
        "properties": {
          "type": { "enum": ["SUPERSEDES", "REFINES"] },
          "target_id": { "type": "string", "pattern": "^rinse-reflection-[0-9a-f]{16}$" }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" }
      }
    },
    "recorded_time": { "type": "string", "format": "date-time" },
    "reviewed_time": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "proposed_transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target_state", "status", "execution_allowed"],
      "properties": {
        "kind": { "const": "REINTERPRETATION_CANDIDATE" },
        "target_state": { "type": "string", "minLength": 1 },
        "status": { "const": "CANDIDATE" },
        "execution_allowed": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "source_trace_mutation_authorized",
        "evidence_mutation_authorized",
        "truth_authorized",
        "execution_authorized"
      ],
      "properties": {
        "classification": { "const": "REFLECTION_ONLY" },
        "source_trace_mutation_authorized": { "const": false },
        "evidence_mutation_authorized": { "const": false },
        "truth_authorized": { "const": false },
        "execution_authorized": { "const": false }
      }
    }
  }
}
